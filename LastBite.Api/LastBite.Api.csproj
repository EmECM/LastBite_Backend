<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LastBite.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>2f535927-c7c2-43b1-9b9e-35d83a7e464c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Acceso a datos: Dapper sobre Npgsql. No usamos Entity Framework. -->
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Dapper" Version="2.1.79" />

    <!-- Hash de contraseñas. Genera y verifica el formato $2a$ que usa S003. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />

    <!-- Autenticación con JWT. La versión sigue a la del runtime de .NET 8. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />

    <!-- Swagger: es la forma en que el frontend prueba los endpoints. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
